local function buildAutoKill()
    clearCenter()
    local akPA, akPR
    afStatusLbl=addCenterStatus("AUTO KILL OFF",TEXTDIM)
    -- Restaurar status si hay algún modo activo
    for m,active in pairs(AutoKillActive) do
        if active then
            if afStatusLbl and afStatusLbl.Parent then afStatusLbl.Text="ON: "..m; afStatusLbl.TextColor3=GREEN end
            break
        end
    end
    addCenterHPBar()
    addCenterSeparator()
    addCenterLabel("Modo de AutoKill",ACCENT)

    local toggleRefs={}
    local modeList={
        {id="nobudda",     label="AutoKill-NoBudda",    desc="40 studs · Orbita rapido (x1)"},
        {id="buda",        label="AutoKill-Buda",        desc="388 studs · Orbita medio (x0.5)"},
        {id="budaskinbug", label="AutoKill-BudaSkinBug", desc="850 studs · Orbita lento (x0.3)"},
    }

    for _,md in ipairs(modeList) do
        local card=Instance.new("Frame",centerScroll)
        card.Size=UDim2.new(1,0,0,60); card.BackgroundColor3=CARD; card.BorderSizePixel=0; card.ZIndex=6
        Instance.new("UICorner",card).CornerRadius=UDim.new(0,8)
