-- SAFE ZONE v4 - TP continuo mientras te golpeen
local setSafeZone
do
    local safeConn=nil; local safeZoneEnabled=false
    local SAFE_HEIGHT = 9e8
    local DRAG_RADIUS = 30

    local lastHP = nil
    local beingAttacked = false
    local attackDetectConn = nil
    local tpLoopConn = nil

    local function isStunnedOrPulled(hum, root)
        if not hum or not root then return false end
        if hum.PlatformStand then return true end
        local ok, state = pcall(function() return hum:GetState() end)
        if ok then
            if state == Enum.HumanoidStateType.FallingDown then return true end
            if state == Enum.HumanoidStateType.Ragdoll then return true end
        end
        local vel = root.AssemblyLinearVelocity
        if Vector3.new(vel.X, 0, vel.Z).Magnitude > 55 then return true end
        return false
    end

    local function dragNearbyPlayers(myPos)
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= lp and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - myPos).Magnitude <= DRAG_RADIUS then
                    pcall(function()
                        hrp.CFrame = CFrame.new(myPos + Vector3.new(0, SAFE_HEIGHT, 0))
                        hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    end)
                end
            end
        end
    end

    local function doSafeTP()
        local hum=GetHum(); local root=GetRoot()
        if not hum or not root then return end
        local myPos = root.Position
        pcall(function()
            dragNearbyPlayers(myPos)
            root.AssemblyLinearVelocity = Vector3.new(0,0,0)
            root.AssemblyAngularVelocity = Vector3.new(0,0,0)
            root.CFrame = CFrame.new(myPos + Vector3.new(0, SAFE_HEIGHT, 0))
            root.AssemblyLinearVelocity = Vector3.new(0,0,0)
            pcall(function()
                hum.PlatformStand = false
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end)
    end

    local function stopTPLoop()
        beingAttacked=false
        if tpLoopConn then tpLoopConn:Disconnect(); tpLoopConn=nil end
        if attackDetectConn then attackDetectConn:Disconnect(); attackDetectConn=nil end
        lastHP=nil
    end

    setSafeZone=function(v)
        safeZoneEnabled=v
        if safeConn then safeConn:Disconnect(); safeConn=nil end
        stopTPLoop()
        if v then
            safeConn=RunService.Heartbeat:Connect(function()
                if not safeZoneEnabled then return end
                local hum=GetHum(); if not hum then return end
                local root=GetRoot(); if not root then return end

                -- Detectar si alguien nos está golpeando (caída de HP)
                local curHP=hum.Health
                if lastHP and curHP < lastHP - 1 then
                    -- Nos golpearon! Iniciar loop de TP
                    if not beingAttacked then
                        beingAttacked=true
                        doSafeTP()
                        -- Loop que sigue TPeando cada 0.3s mientras la HP baje
                        local noHitTimer=0
                        local prevHPLoop=curHP
                        tpLoopConn=RunService.Heartbeat:Connect(function(dt)
                            if not safeZoneEnabled then stopTPLoop(); return end
                            local h2=GetHum(); if not h2 then stopTPLoop(); return end
                            local curHP2=h2.Health
                            if curHP2 < prevHPLoop - 0.5 then
                                -- Siguen golpeando, TP de nuevo
                                doSafeTP()
                                noHitTimer=0
                                prevHPLoop=curHP2
                            else
                                noHitTimer+=dt
                                if noHitTimer>2.5 then
                                    -- 2.5s sin daño = dejaron de golpear
                                    stopTPLoop()
                                end
                            end
                        end)
                    end
                end
                lastHP=curHP

                -- Tambien activar por stun (como antes)
                local lowHp = hum.Health > 0 and hum.Health <= 6000
                local stunned = isStunnedOrPulled(hum, root)
                if (lowHp or stunned) and not beingAttacked then
                    doSafeTP()
                end
            end)
        end
    end
end

