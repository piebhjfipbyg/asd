local function ESP_RemoveChams(player)
    if ChamsObjects[player] then
        for _, h in pairs(ChamsObjects[player].Highlights) do if h and h.Parent then h:Destroy() end end
        ChamsObjects[player] = nil
    end
end

local function ESP_UpdateChams()
    for player, chamsData in pairs(ChamsObjects) do
        if not player or not player.Parent then ESP_RemoveChams(player); continue end
        for _, highlight in pairs(chamsData.Highlights) do
            if highlight and highlight.Parent then
                highlight.Enabled = ESPConfig.ShowChams; highlight.FillColor = ESPConfig.ChamsColor
                if player.Character then
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    local myHrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and myHrp then
                        local dist = (hrp.Position - myHrp.Position).Magnitude
                        highlight.Enabled = ESPConfig.ShowChams and dist <= ESPConfig.MaxDistance
                    end
                end
            end
        end
    end
end

