                local wled,reason=isWhitelistedWithInfo(plr)
                if cd.lastWlState~=wled or cd.lastReason~=reason then
                    cd.lastWlState=wled; cd.lastReason=reason
                    pcall(function()
                        local isM=(reason=="marine")
                        local sc=isM and MARINE_BLUE or (wled and Color3.fromRGB(60,120,60) or SEP)
                        local bc=isM and Color3.fromRGB(12,14,24) or (wled and Color3.fromRGB(12,18,12) or CARD)
                        local ic=isM and Color3.fromRGB(16,22,40) or (wled and Color3.fromRGB(18,35,18) or ACCENTD)
                        local tc=isM and MARINE_BLUE or (wled and WLGREEN or ACCENTB)
                        cd.stroke.Color=sc; cd.card.BackgroundColor3=bc; cd.iBg.BackgroundColor3=ic; cd.iL.TextColor3=tc; cd.nameLbl.TextColor3=tc
