        local col=Color3.fromHSV(curHue,curSat,curVal)
        AbilityColor=col
        statusDot.BackgroundColor3=col
        statusLbl.Text=string.format("RGB %d %d %d",math.floor(col.R*255),math.floor(col.G*255),math.floor(col.B*255))
