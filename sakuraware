-- COLORS
AbilityColor = Color3.fromRGB(255, 0, 0)
colorConn = nil
local colorActive = false
local colorOriginals = {}
local colorIgnorar = {"haki","buso","armament","leviathan","shield","escudo"}
local colorDescConn = nil
local colorCharConn = nil

local function colorDebeIgnorar(n)
    n=string.lower(n)
    for _,p in pairs(colorIgnorar) do if n:find(p) then return true end end
    return false
end

local function colorGuardarYCambiar(obj, col)
    if not obj or not obj.Parent then return end
    if colorDebeIgnorar(obj.Name) then return end
    if obj.Parent and colorDebeIgnorar(obj.Parent.Name) then return end
    pcall(function()
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
            if not colorOriginals[obj] then colorOriginals[obj]={orig=obj.Color} end
            obj.Color=ColorSequence.new(col)
        elseif obj:IsA("BasePart") and obj.Material==Enum.Material.Neon then
            if not colorOriginals[obj] then colorOriginals[obj]={orig=obj.Color} end
            obj.Color=col
        elseif obj:IsA("PointLight") then
            if not colorOriginals[obj] then colorOriginals[obj]={orig=obj.Color} end
            obj.Color=col
        end
    end)
end

local function restaurarColores()
    for obj,data in pairs(colorOriginals) do
        pcall(function() if obj and obj.Parent then obj.Color=data.orig end end)
    end
    colorOriginals={}
end

local function activarColor(col)
    AbilityColor=col
    if colorConn then colorConn:Disconnect(); colorConn=nil end
    if colorDescConn then colorDescConn:Disconnect(); colorDescConn=nil end
    if colorCharConn then colorCharConn:Disconnect(); colorCharConn=nil end
    if not colorActive then return end
    pcall(function()
        local ef=game:GetService("ReplicatedStorage"):FindFirstChild("Effect")
        if ef then for _,d in pairs(ef:GetDescendants()) do colorGuardarYCambiar(d,col) end end
    end)
    pcall(function()
        local char=lp.Character
        if char then for _,obj in pairs(char:GetDescendants()) do colorGuardarYCambiar(obj,col) end end
    end)
    colorConn=workspace.DescendantAdded:Connect(function(obj)
        if not colorActive then return end
        colorGuardarYCambiar(obj,col)
    end)
    local function conectarChar(char)
        if colorCharConn then colorCharConn:Disconnect() end
        colorCharConn=char.DescendantAdded:Connect(function(obj)
            if colorActive then colorGuardarYCambiar(obj,col) end
        end)
        for _,obj in pairs(char:GetDescendants()) do colorGuardarYCambiar(obj,col) end
    end
    if lp.Character then conectarChar(lp.Character) end
    lp.CharacterAdded:Connect(function(c) task.wait(0.3); if colorActive then conectarChar(c) end end)
    pcall(function()
        local ef=game:GetService("ReplicatedStorage"):FindFirstChild("Effect")
        if ef then
            colorDescConn=ef.DescendantAdded:Connect(function(obj)
                if colorActive then colorGuardarYCambiar(obj,col) end
            end)
        end
    end)
end

