        highlight.OutlineTransparency = 0; highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Enabled = ESPConfig.ShowChams; highlight.Parent = character
        table.insert(chamsData.Highlights, highlight)
    end
    if player.Character then setupHighlight(player.Character) end
    player.CharacterAdded:Connect(function(character) task.wait(0.1); setupHighlight(character) end)
