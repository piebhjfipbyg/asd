            if draggingSlider then updateSlider(inp.Position.X) end
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 then draggingWheel=false; draggingSlider=false end
    end)
end
