local function registerBind(featureId, defaultKey, toggleFn)
    local existing = KeyBindRegistry[featureId]
    if existing then existing.toggleFn = toggleFn
    else KeyBindRegistry[featureId] = {key=defaultKey or nil, toggleFn=toggleFn, state=false} end
end
local function registerAction(featureId, defaultKey, actionFn)
    KeyActionRegistry[featureId] = {key=defaultKey or nil, actionFn=actionFn}
end

