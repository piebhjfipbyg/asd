local function saveConfig()
    -- Construir keybinds, actions y toggles como strings JSON manualmente
    -- para evitar que tablas vacias se serialicen como [] en vez de {}
    local function buildJsonObject(tbl)
        local parts = {}
        for k, v in pairs(tbl) do
            local val
            if type(v) == "string" then val = '"'..v..'"'
            elseif type(v) == "boolean" then val = tostring(v)
            elseif type(v) == "number" then val = tostring(v)
            else val = '"'..tostring(v)..'"' end
            table.insert(parts, '"'..tostring(k)..'":'..val)
        end
        return "{"..table.concat(parts,",").."}"
    end

    local keybindsRaw = {}
    for id, b in pairs(KeyBindRegistry) do
        if b.key then keybindsRaw[id] = b.key.Name end
    end
    local actionsRaw = {}
    for id, a in pairs(KeyActionRegistry) do
        if a.key then actionsRaw[id] = a.key.Name end
    end
    local togglesRaw = {}
    for id, b in pairs(KeyBindRegistry) do
        togglesRaw[id] = b.state or false
    end

    local data = {
        menuKey    = menuKeyName or "RAlt",
        sky        = currentSkyPreset or nil,
        music      = MusicEnabled,
        fly        = { Speed = _G.__SakuraFlyConfigSave and _G.__SakuraFlyConfigSave.Speed or 50 },
        aimbot     = {
            FOVRadius   = AimCfg and AimCfg.FOVRadius   or 120,
            FOVTransp   = AimCfg and AimCfg.FOVTransp   or 70,
            Smoothness  = AimCfg and AimCfg.Smoothness  or 8,
            Sensitivity = AimCfg and AimCfg.Sensitivity or 80,
            UseFOV      = AimCfg and AimCfg.UseFOV      or false,
            Mode        = AimCfg and AimCfg.Mode        or "toggle",
        },
        hitboxP    = {
            Size   = HPlayerCfg and HPlayerCfg.Size   or 1000,
            Transp = HPlayerCfg and HPlayerCfg.Transp or 0.92,
        },
        hitboxN    = {
            Size   = HNpcCfg and HNpcCfg.Size   or 1000,
            Transp = HNpcCfg and HNpcCfg.Transp or 0.97,
        },
        fastattack = {
            Range = FastAttackCfg and FastAttackCfg.Range or 2000,
        },
    }

    pcall(function()
        local ok, mainJson = pcall(function() return HttpService:JSONEncode(data) end)
        if not ok then return end
        -- Insertar keybinds, actions y toggles como objetos reales
        local keybindsJson = buildJsonObject(keybindsRaw)
        local actionsJson  = buildJsonObject(actionsRaw)
        local togglesJson  = buildJsonObject(togglesRaw)
        -- Remover el ultimo } y agregar los campos extras
        local final = mainJson:sub(1, -2)
        final = final ..',"keybinds":'..keybindsJson
        final = final ..',"actions":'..actionsJson
        final = final ..',"toggles":'..togglesJson.."}"
        writefile(CONFIG_FILE, final)
    end)
end

-- Fase 1: leer el archivo y guardar en buffer (se llama al inicio)
local function readSavedConfig()
    local ok, content = pcall(function() return readfile(CONFIG_FILE) end)
    if not ok or not content or content == "" then return end
    local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok2 or not data then return end

    -- Extraer keybinds, actions y toggles manualmente del texto raw
    -- porque JSONDecode puede convertir {"fly":"H"} a array si Roblox lo malinterpreta
    local function extractJsonObject(raw, key)
        local result = {}
        -- Buscar "key":{...}
        local pattern = '"'..key..'":%s*(%b{})'
        local objStr = raw:match(pattern)
        if not objStr then return result end
        -- Parsear pares "clave":"valor" o "clave":true/false
        for k, v in objStr:gmatch('"([^"]+)"%s*:%s*"([^"]+)"') do
            result[k] = v
        end
        for k, v in objStr:gmatch('"([^"]+)"%s*:%s*(true)') do
            result[k] = true
        end
        for k, v in objStr:gmatch('"([^"]+)"%s*:%s*(false)') do
            result[k] = false
        end
        return result
    end

    data.keybinds = extractJsonObject(content, "keybinds")
    data.actions  = extractJsonObject(content, "actions")
    data.toggles  = extractJsonObject(content, "toggles")

    -- Convertir valores de toggles a boolean correctamente
    for k, v in pairs(data.toggles) do
        if v == "true" then data.toggles[k] = true
        elseif v == "false" then data.toggles[k] = false end
    end

    _savedData = data
end

-- Fase 2: aplicar configs de valores (numeros, bools) - se llama despues de definir las variables
local function applyConfigValues()
    if not _savedData then return end
    local data = _savedData
    -- Menu key
    if data.menuKey then
        pcall(function()
            for _, item in ipairs(Enum.KeyCode:GetEnumItems()) do
                if item.Name == data.menuKey then
                    MENU_KEY = item; menuKeyName = data.menuKey; break
                end
            end
        end)
    end
    -- Fly speed
    if data.fly then
        pcall(function()
            local fc = _G.__SakuraFlyConfigSave
            if fc and data.fly.Speed then fc.Speed = data.fly.Speed end
        end)
    end
    -- Aimbot
    if data.aimbot and AimCfg then pcall(function()
        if data.aimbot.FOVRadius   then AimCfg.FOVRadius   = data.aimbot.FOVRadius   end
        if data.aimbot.FOVTransp   then AimCfg.FOVTransp   = data.aimbot.FOVTransp   end
        if data.aimbot.Smoothness  then AimCfg.Smoothness  = data.aimbot.Smoothness  end
        if data.aimbot.Sensitivity then AimCfg.Sensitivity = data.aimbot.Sensitivity end
        if data.aimbot.UseFOV ~= nil then AimCfg.UseFOV   = data.aimbot.UseFOV      end
        if data.aimbot.Mode        then AimCfg.Mode        = data.aimbot.Mode        end
    end) end
    -- Hitbox Players
    if data.hitboxP and HPlayerCfg then pcall(function()
        if data.hitboxP.Size   then HPlayerCfg.Size   = data.hitboxP.Size   end
        if data.hitboxP.Transp then HPlayerCfg.Transp = data.hitboxP.Transp end
    end) end
    -- Hitbox NPCs
    if data.hitboxN and HNpcCfg then pcall(function()
        if data.hitboxN.Size   then HNpcCfg.Size   = data.hitboxN.Size   end
        if data.hitboxN.Transp then HNpcCfg.Transp = data.hitboxN.Transp end
    end) end
    -- Fast attack range
    if data.fastattack and FastAttackCfg then pcall(function()
        if data.fastattack.Range then FastAttackCfg.Range = data.fastattack.Range end
    end) end
    -- Musica
    if data.music ~= nil then MusicEnabled = data.music end
end

