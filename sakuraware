local function isWhitelisted(player)
    if not player then return false end
    local n=player.Name
    if Whitelist[n]==true then return true end
    if AutoAllyWL[n] then return true end
    if AutoAllyWL[player.DisplayName] then return true end
    if isPlayerMarine(player) then return true end
    return false
end

local function isWhitelistedWithInfo(player)
    if not player then return false,nil end
    local n=player.Name
    if Whitelist[n]==true then return true,"manual" end
    if AutoAllyWL[n] then return true,"bf_ally" end
    if AutoAllyWL[player.DisplayName] then return true,"bf_ally" end
    if isPlayerMarine(player) then return true,"marine" end
    return false,nil
end

