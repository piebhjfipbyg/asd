    end
    if HPlayerCfg then add("ps", HPlayerCfg.Size); add("pt", HPlayerCfg.Transp) end
    if HNpcCfg then add("ns", HNpcCfg.Size); add("nt", HNpcCfg.Transp) end
    if FastAttackCfg then add("fr", FastAttackCfg.Range) end
    -- Keybinds: kb_<id>=<keyName>
    for id,b in pairs(KeyBindRegistry) do
        if b.key then table.insert(parts, "kb_"..id.."#"..b.key.Name) end
    end
    -- Actions: ka_<id>=<keyName>
    for id,a in pairs(KeyActionRegistry) do
        if a.key then table.insert(parts, "ka_"..id.."#"..a.key.Name) end
    end
    -- Toggles: tg_<id>=0/1
    for id,b in pairs(KeyBindRegistry) do
        table.insert(parts, "tg_"..id.."#"..((b.state and 1) or 0))
    end
    return b64Encode(table.concat(parts, "|"))
end

local function nameToKeyCodeShare(name)
    if not name or name=="" then return nil end
    local ok,kc = pcall(function() return Enum.KeyCode[name] end)
    if ok and kc and tostring(kc)~=tostring(Enum.KeyCode.Unknown) then return kc end
    for _,it in ipairs(Enum.KeyCode:GetEnumItems()) do
        if it.Name==name then return it end
    end
    return nil
end

local function importShareConfig(code)
    if not code or code=="" then return false, "Codigo vacio" end
    local raw = b64Decode(code:match("^%s*(.-)%s*$"))
    if not raw or raw=="" then return false, "Codigo invalido" end
    local kv = {}
    for token in raw:gmatch("[^|]+") do
        local k,v = token:match("^(.-)#(.*)$")
        if k then kv[k] = v end
    end
    if next(kv)==nil then return false, "Formato incorrecto" end

    -- Menu key
    if kv.mk then
        local kc = nameToKeyCodeShare(kv.mk)
        if kc then MENU_KEY = kc; menuKeyName = kv.mk end
    end
    -- Music
    if kv.mu then
        local on = kv.mu=="1"
        MusicEnabled = on
        pcall(function() if on then if playMusic then playMusic() end else if stopMusic then stopMusic() end end end)
    end
    -- Fly speed
    if kv.fs then
        local fc = _G.__SakuraFlyConfigSave
        if fc then fc.Speed = tonumber(kv.fs) or fc.Speed end
        if FlyConfig then FlyConfig.Speed = tonumber(kv.fs) or FlyConfig.Speed end
    end
    -- Aimbot
    if AimCfg then
        if kv.ar then AimCfg.FOVRadius   = tonumber(kv.ar) or AimCfg.FOVRadius end
        if kv.at then AimCfg.FOVTransp   = tonumber(kv.at) or AimCfg.FOVTransp end
        if kv.as then AimCfg.Smoothness  = tonumber(kv.as) or AimCfg.Smoothness end
        if kv.ax then AimCfg.Sensitivity = tonumber(kv.ax) or AimCfg.Sensitivity end
        if kv.au then AimCfg.UseFOV      = kv.au=="1" end
        if kv.am then AimCfg.Mode        = kv.am end
    end
    -- Hitbox P
    if HPlayerCfg then
        if kv.ps then HPlayerCfg.Size   = tonumber(kv.ps) or HPlayerCfg.Size end
        if kv.pt then HPlayerCfg.Transp = tonumber(kv.pt) or HPlayerCfg.Transp end
    end
    -- Hitbox N
    if HNpcCfg then
        if kv.ns then HNpcCfg.Size   = tonumber(kv.ns) or HNpcCfg.Size end
        if kv.nt then HNpcCfg.Transp = tonumber(kv.nt) or HNpcCfg.Transp end
    end
    -- Fast attack
    if FastAttackCfg and kv.fr then FastAttackCfg.Range = tonumber(kv.fr) or FastAttackCfg.Range end
    -- Sky
    if kv.sk and kv.sk~="" and SkyPresets and applySkyPreset then
        pcall(function()
            for _,p in ipairs(SkyPresets) do
                if p.name==kv.sk then applySkyPreset(p); break end
            end
        end)
    end
    -- Keybinds
    for k,v in pairs(kv) do
        local id = k:match("^kb_(.+)$")
        if id and KeyBindRegistry[id] then
            local kc = nameToKeyCodeShare(v)
            if kc then KeyBindRegistry[id].key = kc end
        end
    end
    -- Actions
    for k,v in pairs(kv) do
        local id = k:match("^ka_(.+)$")
        if id and KeyActionRegistry[id] then
            local kc = nameToKeyCodeShare(v)
            if kc then KeyActionRegistry[id].key = kc end
        end
    end
    -- Toggles
    for k,v in pairs(kv) do
        local id = k:match("^tg_(.+)$")
        if id and KeyBindRegistry[id] then
            local want = v=="1"
            local b = KeyBindRegistry[id]
            if b.state ~= want then
                pcall(function()
                    b.state = want
                    if b.syncToggle then b.syncToggle(want)
                    elseif b.toggleFn then b.toggleFn(want) end
                end)
            end
        end
    end
    pcall(saveConfig)
    return true, "Config aplicada"
end

