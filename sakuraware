    Instance.new("UICorner",akScroll).CornerRadius=UDim.new(0,6)
    Instance.new("UIListLayout",akScroll).Padding=UDim.new(0,3)
    do local p=Instance.new("UIPadding",akScroll); p.PaddingTop=UDim.new(0,4); p.PaddingBottom=UDim.new(0,4); p.PaddingLeft=UDim.new(0,4); p.PaddingRight=UDim.new(0,4) end

    local function refreshAKList()
        for _,c in ipairs(akScroll:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
        for _,plr in ipairs(Players:GetPlayers()) do
            if plr~=lp and not isWhitelisted(plr) then addMiniPlayerCard(akScroll,plr) end
        end
    end
    refreshAKList()

    local akRef=Instance.new("TextButton",centerScroll)
    akRef.Size=UDim2.new(0,80,0,22); akRef.BackgroundColor3=ACCENTD
    akRef.Text="Refresh List"; akRef.TextColor3=ACCENT; akRef.TextSize=9
    akRef.Font=Enum.Font.GothamBold; akRef.BorderSizePixel=0; akRef.ZIndex=7; akRef.AutoButtonColor=false
    Instance.new("UICorner",akRef).CornerRadius=UDim.new(0,5)
    akRef.MouseButton1Click:Connect(function() SND_CLICK:Play(); refreshAKList() end)

    if akPA then akPA:Disconnect() end
    if akPR then akPR:Disconnect() end
    akPA=Players.PlayerAdded:Connect(function() task.wait(1); if akScroll and akScroll.Parent then refreshAKList() end end)
    akPR=Players.PlayerRemoving:Connect(function(plr)
        if selectedTarget==plr then selectedTarget=nil; stopAllAutoKills() end
        task.wait(0.5); if akScroll and akScroll.Parent then refreshAKList() end
    end)
end

