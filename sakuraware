local function applyConfigBindsAndToggles()
    print("[SW-DEBUG] applyConfigBindsAndToggles ejecutado, _savedData=", _savedData ~= nil)
    if not _savedData then print("[SW-DEBUG] NO HAY SAVEDDATA, saliendo"); return end
    local data = _savedData
    print("[SW-DEBUG] keybinds en data:", data.keybinds ~= nil, "tipo:", type(data.keybinds))
    if data.keybinds then
        local count = 0
        for k,v in pairs(data.keybinds) do
            count = count + 1
            print("[SW-DEBUG] keybind encontrado:", k, "=", v)
        end
        print("[SW-DEBUG] total keybinds:", count)
        -- Ver si es array o tabla
        print("[SW-DEBUG] keybinds[fly]=", data.keybinds["fly"])
        print("[SW-DEBUG] keybinds[aimbot]=", data.keybinds["aimbot"])
        -- Ver raw JSON
        local ok, raw = pcall(function() return game:GetService("HttpService"):JSONEncode(data.keybinds) end)
        print("[SW-DEBUG] keybinds JSON raw:", raw)
    end

    -- Helper para convertir nombre a KeyCode de forma segura
    local function nameToKeyCode(name)
        if not name or name == "" then return nil end
        -- Intentar indexacion directa primero
        local ok, kc = pcall(function() return Enum.KeyCode[name] end)
        if ok and kc and tostring(kc) ~= tostring(Enum.KeyCode.Unknown) then return kc end
        -- Fallback: buscar en GetEnumItems
        for _, item in ipairs(Enum.KeyCode:GetEnumItems()) do
            if item.Name == name then return item end
        end
        return nil
    end

    -- Keybinds
    if data.keybinds then
        for id, keyName in pairs(data.keybinds) do
            if type(keyName) == "string" then
                local kc = nameToKeyCode(keyName)
                local inReg = KeyBindRegistry[id] ~= nil
                print("[SW-DEBUG] keybind id="..tostring(id).." key="..tostring(keyName).." kc="..tostring(kc).." inRegistry="..tostring(inReg))
                if kc and KeyBindRegistry[id] then
                    KeyBindRegistry[id].key = kc
                    print("[SW-DEBUG] APLICADO: "..id.." = "..keyName)
                end
            end
        end
    end
    -- Actions
    if data.actions then
        for id, keyName in pairs(data.actions) do
            if type(keyName) == "string" then
                local kc = nameToKeyCode(keyName)
                if kc and KeyActionRegistry[id] then
                    KeyActionRegistry[id].key = kc
                end
            end
        end
    end
    -- Estados on/off: activar toggles que estaban encendidos
    if data.toggles then
        for id, state in pairs(data.toggles) do
            if state == true then
                local b = KeyBindRegistry[id]
                if b then
                    pcall(function()
                        b.state = true
                        if b.syncToggle then
                            b.syncToggle(true)
                        elseif b.toggleFn then
                            b.toggleFn(true)
                        end
                    end)
                end
            end
        end
    end
    -- Sky changer
    if data.sky and data.sky ~= "" then
        pcall(function()
            for _, preset in ipairs(SkyPresets) do
                if preset.name == data.sky then
                    applySkyPreset(preset); break
                end
            end
        end)
    end
    -- Musica
    if data.music == false then
        pcall(function() MusicEnabled = false; stopMusic() end)
    end
end
