    -- Registrar anticipadamente todos los features con sus callbacks reales
    -- para que applyConfigBindsAndToggles pueda activarlos aunque no se haya abierto la categoria
    local function ensureRegistered(id, toggleFn)
        if not KeyBindRegistry[id] then
            KeyBindRegistry[id] = {key=nil, toggleFn=toggleFn, state=false}
        elseif not KeyBindRegistry[id].toggleFn then
            KeyBindRegistry[id].toggleFn = toggleFn
        end
        if not KeyBindRegistry[id].syncToggle then
            KeyBindRegistry[id].syncToggle = function(state)
                KeyBindRegistry[id].state = state
                if toggleFn then pcall(toggleFn, state) end
            end
        end
    end

