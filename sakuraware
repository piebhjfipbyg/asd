local function ESP_UpdateESP()
    for player, espData in pairs(ESPObjects) do
        if not player or not player.Parent or not player.Character then
            for _, d in pairs(espData.Drawings) do d.Visible = false end; continue
        end
        local character = player.Character
        local hrp = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local head = character:FindFirstChild("Head")
        if not hrp or not humanoid or not head then
            for _, d in pairs(espData.Drawings) do d.Visible = false end; continue
        end
        local myChar = lp.Character; local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then for _, d in pairs(espData.Drawings) do d.Visible = false end; continue end
        local distance = (hrp.Position - myHrp.Position).Magnitude
        if distance > ESPConfig.MaxDistance then
            for _, d in pairs(espData.Drawings) do d.Visible = false end; continue
        end
        local topPos = head.Position + Vector3.new(0, head.Size.Y/2 + 0.5, 0)
        local bottomPos = hrp.Position - Vector3.new(0, 3, 0)
        local topScreen, topVisible = ESPCamera:WorldToViewportPoint(topPos)
        local bottomScreen, bottomVisible = ESPCamera:WorldToViewportPoint(bottomPos)
        if not topVisible or not bottomVisible then
            for _, d in pairs(espData.Drawings) do d.Visible = false end; continue
        end
        local boxHeight = math.abs(topScreen.Y - bottomScreen.Y)
        local boxWidth = boxHeight * 0.6
        local topLeft = Vector2.new(topScreen.X - boxWidth/2, topScreen.Y)
        local topRight = Vector2.new(topScreen.X + boxWidth/2, topScreen.Y)
        local bottomLeft = Vector2.new(bottomScreen.X - boxWidth/2, bottomScreen.Y)
        local bottomRight = Vector2.new(bottomScreen.X + boxWidth/2, bottomScreen.Y)
        local cornerSize = math.min(boxWidth*0.25, boxHeight*0.15)
        if ESPConfig.ShowBox then
            local L=espData.Drawings
            L.Line1.From=topLeft; L.Line1.To=Vector2.new(topLeft.X,topLeft.Y+cornerSize); L.Line1.Visible=true
            L.Line2.From=topLeft; L.Line2.To=Vector2.new(topLeft.X+cornerSize,topLeft.Y); L.Line2.Visible=true
            L.Line3.From=topRight; L.Line3.To=Vector2.new(topRight.X,topRight.Y+cornerSize); L.Line3.Visible=true
            L.Line4.From=topRight; L.Line4.To=Vector2.new(topRight.X-cornerSize,topRight.Y); L.Line4.Visible=true
            L.Line5.From=bottomLeft; L.Line5.To=Vector2.new(bottomLeft.X,bottomLeft.Y-cornerSize); L.Line5.Visible=true
            L.Line6.From=bottomLeft; L.Line6.To=Vector2.new(bottomLeft.X+cornerSize,bottomLeft.Y); L.Line6.Visible=true
            L.Line7.From=bottomRight; L.Line7.To=Vector2.new(bottomRight.X,bottomRight.Y-cornerSize); L.Line7.Visible=true
            L.Line8.From=bottomRight; L.Line8.To=Vector2.new(bottomRight.X-cornerSize,bottomRight.Y); L.Line8.Visible=true
        else for i=1,8 do espData.Drawings["Line"..i].Visible=false end end
        if ESPConfig.ShowTracers then
            local sc=Vector2.new(ESPCamera.ViewportSize.X/2,ESPCamera.ViewportSize.Y)
            espData.Drawings.Tracer.From=sc; espData.Drawings.Tracer.To=Vector2.new(bottomScreen.X,bottomScreen.Y)
            espData.Drawings.Tracer.Color=ESPConfig.TracerColor; espData.Drawings.Tracer.Visible=true
        else espData.Drawings.Tracer.Visible=false end
        if ESPConfig.ShowSkeleton then
            local skC={{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}}
            for i,conn in ipairs(skC) do
                local p1=character:FindFirstChild(conn[1]); local p2=character:FindFirstChild(conn[2])
                if p1 and p2 then
                    local s1,v1=ESPCamera:WorldToViewportPoint(p1.Position); local s2,v2=ESPCamera:WorldToViewportPoint(p2.Position)
                    if v1 and v2 then espData.Drawings["Skeleton"..i].From=Vector2.new(s1.X,s1.Y); espData.Drawings["Skeleton"..i].To=Vector2.new(s2.X,s2.Y); espData.Drawings["Skeleton"..i].Color=ESPConfig.SkeletonColor; espData.Drawings["Skeleton"..i].Visible=true
                    else espData.Drawings["Skeleton"..i].Visible=false end
                else espData.Drawings["Skeleton"..i].Visible=false end
            end
        else for i=1,14 do espData.Drawings["Skeleton"..i].Visible=false end end
        if ESPConfig.ShowHealthBar then
            local hp=humanoid.Health/humanoid.MaxHealth; local bw=4; local bh=boxHeight
            espData.Drawings.HealthBarBg.Size=Vector2.new(bw,bh); espData.Drawings.HealthBarBg.Position=Vector2.new(topLeft.X-bw-4,topLeft.Y); espData.Drawings.HealthBarBg.Visible=true
            local hbh=bh*hp; espData.Drawings.HealthBar.Size=Vector2.new(bw,hbh); espData.Drawings.HealthBar.Position=Vector2.new(topLeft.X-bw-4,bottomLeft.Y-hbh)
            espData.Drawings.HealthBar.Color=hp>0.6 and Color3.fromRGB(0,150,0) or (hp>0.3 and Color3.fromRGB(255,200,0) or Color3.fromRGB(200,0,0)); espData.Drawings.HealthBar.Visible=true
        else espData.Drawings.HealthBarBg.Visible=false; espData.Drawings.HealthBar.Visible=false end
        if ESPConfig.ShowHealth then espData.Drawings.HealthText.Text=tostring(math.floor(humanoid.Health)); espData.Drawings.HealthText.Position=Vector2.new(topLeft.X-20,topScreen.Y+boxHeight/2-7); espData.Drawings.HealthText.Visible=true
        else espData.Drawings.HealthText.Visible=false end
        if ESPConfig.ShowName then espData.Drawings.NameText.Position=Vector2.new(topScreen.X,topScreen.Y-18); espData.Drawings.NameText.Visible=true
        else espData.Drawings.NameText.Visible=false end
        if ESPConfig.ShowDistance then espData.Drawings.DistanceText.Text=string.format("%dm",math.floor(distance)); espData.Drawings.DistanceText.Position=Vector2.new(bottomScreen.X,bottomScreen.Y+2); espData.Drawings.DistanceText.Visible=true
        else espData.Drawings.DistanceText.Visible=false end
    end
end

