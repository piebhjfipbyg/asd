        local titleLbl=Instance.new("TextLabel",card)
        titleLbl.Size=UDim2.new(1,-56,0,20); titleLbl.Position=UDim2.new(0,12,0,8)
        titleLbl.BackgroundTransparency=1; titleLbl.Text=md.label
        titleLbl.TextColor3=TEXT; titleLbl.TextSize=11; titleLbl.Font=Enum.Font.GothamBold
        titleLbl.TextXAlignment=Enum.TextXAlignment.Left; titleLbl.ZIndex=7

        local descLbl=Instance.new("TextLabel",card)
        descLbl.Size=UDim2.new(1,-56,0,14); descLbl.Position=UDim2.new(0,12,0,32)
        descLbl.BackgroundTransparency=1; descLbl.Text=md.desc
        descLbl.TextColor3=TEXTDIM; descLbl.TextSize=9; descLbl.Font=Enum.Font.Gotham
        descLbl.TextXAlignment=Enum.TextXAlignment.Left; descLbl.ZIndex=7

        local pill=Instance.new("Frame",card)
        pill.Size=UDim2.new(0,38,0,20); pill.Position=UDim2.new(1,-46,0,8)
        pill.BackgroundColor3=TOGOFF; pill.BorderSizePixel=0; pill.ZIndex=7
        Instance.new("UICorner",pill).CornerRadius=UDim.new(1,0)
        Instance.new("UIStroke",pill).Color=SEP

        local knob=Instance.new("Frame",pill)
        knob.Size=UDim2.new(0,14,0,14); knob.Position=UDim2.new(0,3,0.5,-7)
        knob.BackgroundColor3=TEXTDIM; knob.BorderSizePixel=0; knob.ZIndex=8
        Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)

        local hit=Instance.new("TextButton",card)
        hit.Size=UDim2.new(1,0,1,0); hit.BackgroundTransparency=1; hit.Text=""
        hit.ZIndex=10; hit.AutoButtonColor=false

        local ti=TweenInfo.new(0.14,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
        local function setOn(s)
            if s then
                TweenService:Create(pill,ti,{BackgroundColor3=TOGON}):Play()
                TweenService:Create(knob,ti,{Position=UDim2.new(0,21,0.5,-7),BackgroundColor3=ACCENTB}):Play()
                TweenService:Create(cStroke,ti,{Color=ACCENT}):Play()
            else
                TweenService:Create(pill,ti,{BackgroundColor3=TOGOFF}):Play()
                TweenService:Create(knob,ti,{Position=UDim2.new(0,3,0.5,-7),BackgroundColor3=TEXTDIM}):Play()
                TweenService:Create(cStroke,ti,{Color=SEP}):Play()
            end
        end
        toggleRefs[md.id]=setOn

        hit.MouseEnter:Connect(function() TweenService:Create(card,ti,{BackgroundColor3=CARDHOV}):Play() end)
        hit.MouseLeave:Connect(function() TweenService:Create(card,ti,{BackgroundColor3=CARD}):Play() end)

        local modeId=md.id
        -- Sincronizar visual con estado real al abrir el panel
        if AutoKillActive[modeId] then setOn(true) end

        hit.MouseButton1Click:Connect(function()
            SND_CLICK:Play()
            if AutoKillActive[modeId] then
                stopAutoKill(modeId); setOn(false)
                if afStatusLbl and afStatusLbl.Parent then afStatusLbl.Text="AUTO KILL OFF"; afStatusLbl.TextColor3=TEXTDIM end
                resetHpBar()
            else
                if not selectedTarget then
                    if afStatusLbl and afStatusLbl.Parent then afStatusLbl.Text="Selecciona un target!"; afStatusLbl.TextColor3=YELLOW end
                    return
                end
                -- Apagar los otros visualmente
                for m,ref in pairs(toggleRefs) do if m~=modeId then ref(false) end end
                startAutoKill(modeId, toggleRefs)
                setOn(true)
            end
        end)
    end

    addCenterSeparator()
    addCenterLabel("SELECT TARGET",ACCENT)

    local akScroll=Instance.new("ScrollingFrame",centerScroll)
    akScroll.Size=UDim2.new(1,0,0,200); akScroll.BackgroundColor3=Color3.fromRGB(6,3,5)
    akScroll.BackgroundTransparency=0.55; akScroll.BorderSizePixel=0; akScroll.ZIndex=6
