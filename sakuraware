local function fireKey(kc)
    local vk = VK_MAP[kc.Name]
    -- Disparar AMBOS canales en paralelo: OS-level (keypress) llega a scripts
    -- de juego (ContextActionService de BloxFruits), VIM llega a la capa UI.
    -- Asi un macro Z dispara la habilidad sin importar como la binde el juego.
    if vk then pcall(function() keypress(vk) end) end
    pcall(function()
        local VIM = game:GetService("VirtualInputManager")
        VIM:SendKeyEvent(true, kc, false, game)
    end)
    task.wait(0.012)
    if vk then pcall(function() keyrelease(vk) end) end
    pcall(function()
        local VIM = game:GetService("VirtualInputManager")
        VIM:SendKeyEvent(false, kc, false, game)
    end)
end

local function runMacroActions(macro)
    if macro.keyCode then fireKey(macro.keyCode) end
end

