                        local p=child.Parent; if p then for _,sib in ipairs(p:GetChildren()) do
                            if sib~=child and (sib:IsA("TextLabel") or sib:IsA("TextButton")) and sib.Text then
                                local sn=sib.Text:gsub("%(Remove%)",""):gsub("%(Remover%)",""):gsub("%(Invite%)",""):gsub("%s+","")
