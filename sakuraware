TARGET_MAX_HP = 15850
local selectedTarget   = nil
local afStatusLbl      = nil
local targetHpFill     = nil
local targetHpValueLbl = nil
local selectedCardRef  = {stroke=nil}

local AutoKillActive = {nobudda=false, buda=false, budaskinbug=false}
local AutoKillConns  = {nobudda=nil,   buda=nil,   budaskinbug=nil}

local AK_CONFIG = {
    nobudda      = {dist=40,  orbit=true, orbitSpeed=1.4},
    buda         = {dist=388, orbit=true, orbitSpeed=1.4},
    budaskinbug  = {dist=850, orbit=true, orbitSpeed=0.65},
}

local function resetHpBar()
    if targetHpFill then TweenService:Create(targetHpFill,TweenInfo.new(0.3),{Size=UDim2.new(0,0,1,0)}):Play() end
    if targetHpValueLbl then targetHpValueLbl.Text="--- / "..TARGET_MAX_HP end
end

local function updateHpBar(hum)
    if not hum then resetHpBar(); return end
    local maxHp=math.max(hum.MaxHealth,TARGET_MAX_HP)
    local curHp=math.clamp(hum.Health,0,maxHp)
    local pct=curHp/maxHp
    local col=pct>0.55 and GREEN or (pct>0.25 and YELLOW or RED)
    if targetHpFill then targetHpFill.BackgroundColor3=col; TweenService:Create(targetHpFill,TweenInfo.new(0.1),{Size=UDim2.new(pct,0,1,0)}):Play() end
    if targetHpValueLbl then targetHpValueLbl.Text=math.floor(curHp).." / "..math.floor(maxHp) end
end

local function tryAttack()
    local char=lp.Character; if not char then return end
    for _,child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            pcall(function() child:Activate() end)
            pcall(function() local r=child:FindFirstChildWhichIsA("RemoteEvent",true); if r then r:FireServer() end end)
            break
        end
    end
end

local function stopAutoKill(mode)
    AutoKillActive[mode]=false
    if AutoKillConns[mode] then AutoKillConns[mode]:Disconnect(); AutoKillConns[mode]=nil end
end

local function stopAllAutoKills()
    for m in pairs(AutoKillActive) do stopAutoKill(m) end
    if afStatusLbl and afStatusLbl.Parent then afStatusLbl.Text="AUTO KILL OFF"; afStatusLbl.TextColor3=TEXTDIM end
    resetHpBar()
end

local function startAutoKill(mode, toggleRefs)
    -- Apagar los otros modos
    for m in pairs(AutoKillActive) do
        if m~=mode then
            stopAutoKill(m)
            if toggleRefs and toggleRefs[m] then toggleRefs[m](false) end
        end
    end

    AutoKillActive[mode]=true
    local cfg=AK_CONFIG[mode]
    local angle=0

    if afStatusLbl and afStatusLbl.Parent then
        afStatusLbl.Text="ON: "..mode; afStatusLbl.TextColor3=GREEN
    end

    AutoKillConns[mode]=RunService.Heartbeat:Connect(function(dt)
        if not AutoKillActive[mode] then return end
        local myRoot=GetRoot(); local myHum=GetHum()
        if not myRoot or not myHum or myHum.Health<=0 then return end

        if selectedTarget and selectedTarget.Character and IsAlive(selectedTarget.Character) then
            local tChar=selectedTarget.Character
            local tRoot=tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso")
            local tHum=tChar:FindFirstChildOfClass("Humanoid")

            if tRoot then
                pcall(function()
                    local targetPos=tRoot.Position
                    local newPos

                    if cfg.orbit then
                        angle=angle+dt*(cfg.orbitSpeed or 2.8)
                        local ox=math.cos(angle)*cfg.dist
                        local oz=math.sin(angle)*cfg.dist
                        newPos=Vector3.new(targetPos.X+ox, targetPos.Y+3, targetPos.Z+oz)
                    else
                        -- Mantener distancia fija exacta
                        local dir=myRoot.Position-targetPos
                        local flat=Vector3.new(dir.X,0,dir.Z)
                        if flat.Magnitude<0.01 then flat=Vector3.new(1,0,0) else flat=flat.Unit end
                        newPos=Vector3.new(targetPos.X+flat.X*cfg.dist, targetPos.Y+3, targetPos.Z+flat.Z*cfg.dist)
                    end

                    myRoot.CFrame=CFrame.new(newPos, tRoot.Position)
                    myRoot.AssemblyLinearVelocity=Vector3.new(0,0,0)
                    myRoot.AssemblyAngularVelocity=Vector3.new(0,0,0)
                end)
                tryAttack()
                updateHpBar(tHum)
            end
        else
            if afStatusLbl and afStatusLbl.Parent then afStatusLbl.Text="ON - Sin target..."; afStatusLbl.TextColor3=YELLOW end
            resetHpBar()
        end
    end)
end

