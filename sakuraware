        local abs=wheelFrame.AbsolutePosition; local sz=wheelFrame.AbsoluteSize
        local dx=(inputPos.X-abs.X)-sz.X/2; local dy=(inputPos.Y-abs.Y)-sz.Y/2
        local dist=math.sqrt(dx*dx+dy*dy); local maxR=sz.X/2
        if dist>maxR then local sc=maxR/dist; dx=dx*sc; dy=dy*sc; dist=maxR end
        curHue=(math.atan2(dy,dx)/(2*math.pi)+1)%1; curSat=math.clamp(dist/maxR,0,1)
        local nx=(dx/sz.X)+0.5; local ny=(dy/sz.Y)+0.5
        cursor.Position=UDim2.new(nx,0,ny,0); SND_CLICK:Play(); applyColor()
    end
