local function scanBFAllies()
    updateMyFaction(); local newAllyWL={}
    pcall(function()
        for _,gui in ipairs(pGui:GetChildren()) do
            if SAKURA_GUI_NAMES[gui.Name] then continue end
            if not gui:IsA("ScreenGui") then continue end
            for _,child in ipairs(gui:GetDescendants()) do
                if (child:IsA("TextLabel") or child:IsA("TextButton")) and child.Text then
                    local txt=child.Text
                    if txt:find("%(Remove%)") or txt:find("%(Remover%)") then
                        local cn=txt:gsub("%(Remove%)",""):gsub("%(Remover%)",""):gsub("%(Invite%)",""):gsub("%s+","")
